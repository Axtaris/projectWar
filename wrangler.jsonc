{
  // Static site served by Cloudflare Workers Static Assets: no Worker script, only the files in dist/ (built by build.sh).
  "name": "projectwar",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
